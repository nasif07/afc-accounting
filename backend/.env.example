# Server Configuration
R2_CORS_ORIGINS=http://localhost:5173
PORT=5000
NODE_ENV=development

# Database
# Vercel must define this in Project Settings > Environment Variables.
# Aliases also supported by code: MONGO_URI, MONGO_URL, DATABASE_URL.
MONGODB_URI=mongodb://localhost:27017/alliance-accounting

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Application URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:5000/api

# High Value Transaction Threshold
HIGH_VALUE_THRESHOLD=50000

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Cloudflare R2 (approval-request attachments)
# The bucket is PRIVATE: reads go through short-lived presigned GET URLs minted
# by the API, never a public bucket URL. Browser uploads go straight to R2 via
# presigned PUT, so the bucket needs a CORS rule allowing PUT from CORS_ORIGIN.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=alliance-approvals
# Optional — defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Per-file cap for approval attachments, in bytes. Deliberately separate from
# MAX_FILE_SIZE above, which still governs petty-cash uploads.
APPROVAL_MAX_FILE_SIZE=10485760

# API Keys
STRIPE_SECRET_KEY=your_stripe_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Email notifications (approval requests) ──────────────────────────────────
# Optional. With these unset the app still works — the "notify director" option
# simply reports that email is not configured instead of silently doing nothing.
# SMTP_SECURE defaults to true on port 465 and false otherwise (STARTTLS);
# set it explicitly only if your provider disagrees. Omit SMTP_USER for an
# unauthenticated relay (a local postfix, MailHog, Mailtrap without creds).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=false
MAIL_FROM="Alliance Francaise Accounts <accounts@af-chittagong.org>"

# Public URL of the frontend, used to build the "Review this request" deep link
# in notification emails. Falls back to CORS_ORIGIN when unset.
APP_URL=http://localhost:5173
