NODE_ENV=production
PORT=5000

# The mongo service's port is exposed on the public IP (for Compass), so it
# requires auth. Create this user manually BEFORE enabling --auth in
# docker-compose.prod.yml — see deploy notes. Must match MONGODB_URI below.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-strong-password

# Internal MongoDB service from docker-compose.yml.
# replicaSet=rs0 is required: journal entries use multi-document
# transactions, which MongoDB only supports on a replica set, and the
# mongo service is now started as a single-node replica set (rs0).
# authSource=admin is required since the root user lives in the admin db.
# If you use an external MongoDB server, replace this value.
MONGODB_URI=mongodb://admin:replace-with-a-strong-password@mongo:27017/alliance_accounting?replicaSet=rs0&authSource=admin

# Generate a strong value on the VPS:
# openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Public frontend origin. Required by backend/src/app.js in production.
CORS_ORIGIN=https://accounts.afchittagong.org

# Persistent upload/PDF location inside the backend container.
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=10485760
LOG_LEVEL=info

# Optional, only if you seed the initial director/admin user.
# SEED_ADMIN_EMAIL=director@example.com
# SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# ── Email notifications (approval requests) ──────────────────────────────────
# Optional. With these unset the app still works — the "notify director" option
# simply reports that email is not configured instead of silently doing nothing.
# SMTP_SECURE defaults to true on port 465 and false otherwise (STARTTLS);
# set it explicitly only if your provider disagrees. Omit SMTP_USER for an
# unauthenticated relay (a local postfix, MailHog, Mailtrap without creds).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=false
MAIL_FROM="Alliance Francaise Accounts <accounts@af-chittagong.org>"

# Public URL of the frontend, used to build the "Review this request" deep link
# in notification emails. Falls back to CORS_ORIGIN when unset.
APP_URL=https://accounts.afchittagong.org

# ── Cloudflare R2 (approval attachments + organisation logo) ─────────────────
# Required for file uploads. The bucket is PRIVATE: reads go through
# short-lived presigned GET URLs minted by the API, never a public bucket URL.
# Browser uploads go straight to R2 via presigned PUT, so the bucket's CORS
# policy must allow PUT from CORS_ORIGIN above — a bucket whose CORS rule still
# only lists http://localhost:5173 will fail every upload in production.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=alliance-approvals
# Optional — defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Per-file cap for approval attachments and the logo, in bytes. Deliberately
# separate from MAX_FILE_SIZE above, which still governs petty-cash uploads.
APPROVAL_MAX_FILE_SIZE=10485760
