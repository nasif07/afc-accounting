NODE_ENV=production
PORT=5000

# Internal MongoDB service from docker-compose.yml.
# If you use an external MongoDB server, replace this value.
MONGODB_URI=mongodb://mongo:27017/alliance_accounting

# Generate a strong value on the VPS:
# openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Public frontend origin. Required by backend/src/app.js in production.
CORS_ORIGIN=https://accounts.afchittagong.org

# Persistent upload/PDF location inside the backend container.
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=10485760
LOG_LEVEL=info

# Optional, only if you seed the initial director/admin user.
# SEED_ADMIN_EMAIL=director@example.com
# SEED_ADMIN_PASSWORD=replace-with-a-strong-password
